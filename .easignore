# ═══════════════════════════════════════════════════════════════
# EAS Build Ignore File
# IMPORTANT: .easignore REPLACES .gitignore for EAS builds
# So we must include all .gitignore patterns here too
# ═══════════════════════════════════════════════════════════════

# ─── FROM .gitignore (must be duplicated here) ───
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
KEYSTORE_CREDENTIALS.md
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env
.env*.local
*.tsbuildinfo
nul

# ─── LARGE AUDIO FILES (~72 MB) ───
# All audio streams from raw.githubusercontent.com at runtime
# These local files are NOT referenced by any require() or import
assets/music/

# ─── BACKUP FILES (~2.5 MB, not imported anywhere) ───
assets/backup_onboarding/
backup/
screens/HomeScreen_backup_3.tsx
screens/JournalScreen_Backup.tsx
screens/SettingsScreen_backup_3.tsx
screens/SleepAnalysisScreen_BACKUP_20260119_180959.tsx
ICON_BACKUP.md

# ─── UNUSED FONTS (italic variants not loaded in App.tsx) ───
assets/fonts/Poppins-ThinItalic.ttf
assets/fonts/Poppins-ExtraLightItalic.ttf
assets/fonts/Poppins-LightItalic.ttf
assets/fonts/Poppins-Italic.ttf
assets/fonts/Poppins-MediumItalic.ttf
assets/fonts/Poppins-SemiBoldItalic.ttf
assets/fonts/Poppins-BoldItalic.ttf
assets/fonts/Poppins-ExtraBoldItalic.ttf
assets/fonts/Poppins-BlackItalic.ttf
assets/fonts/Poppins-Thin.ttf
assets/fonts/Poppins-ExtraLight.ttf
assets/fonts/OFL.txt
assets/fonts/README.md

# ─── UNUSED ASSETS ───
assets/old icon.png

# ─── DEV/BUILD ARTIFACTS ───
*.map
.git/
